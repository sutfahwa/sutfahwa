					],
					"path": [
						"objects",
						"{{idObject}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Update object",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var responseBody = pm.response.json(),\r",
							"object_id = pm.variables.get(\"idObject\"); \r",
							"url_path = pm.variables.get(\"URL\");\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response is JSON\", function () {\r",
							"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r",
							"});\r",
							"\r",
							"pm.test(\"ID in response is equal to object_id\", function () {\r",
							"    pm.expect(responseBody.id).to.eql(object_id);\r",
							"});\r",
							"\r",
							"pm.test(\"Device name is Iphone 16 Pro\", function () {\r",
							"    pm.expect(responseBody.name).to.eql(\"Iphone 16 Pro\");\r",
							"});\r",
							"\r",
							"pm.test(\"Price of Object is 49999.99\", function () {\r",
							"    pm.expect(responseBody.data.price).to.eql(49999.99);\r",
							"});\r",
							"\r",
							"pm.test(\"Check name must be equal Iphone 16 Pro after get with ID\", function () {\r",
							"    pm.sendRequest({\r",
							"        url: url_path + \"/objects/\" + object_id, \r",
							"        method: 'GET',\r",
							"        header: {\r",
							"            'Content-Type': 'application/json'\r",
							"        }\r",
							"    }, function (err, res) {\r",
							"        pm.test(\"Status code is 200\", function () {\r",
							"            pm.expect(res).to.have.status(200); // Updated test syntax\r",
							"        });\r",
							"\r",
							"        pm.test(\"Response is JSON\", function () {\r",
							"            pm.expect(res.headers.get('Content-Type')).to.include('application/json');\r",
							"        });\r",
							"\r",
							"        pm.test(\"Device name is Iphone 16 Pro\", function () {\r",
							"            var responseBody = res.json();\r",
							"            pm.expect(responseBody.name).to.eql(\"Iphone 16 Pro\");\r",
							"        });\r",
							"    });\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n   \"name\": \"Iphone 16 Pro\",\r\n   \"data\": {\r\n      \"year\": 2024,\r\n      \"price\": 49999.99,\r\n      \"CPU model\": \"Apple\",\r\n      \"Hard disk size\": \"1 TB\",\r\n      \"color\": \"dark blue\"\r\n   }\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{URL}}/objects/{{idObject}}",
					"host": [
						"{{URL}}"
					],
					"path": [
						"objects",
						"{{idObject}}"
					]
				}
			},
			"response": []
		}
	]
