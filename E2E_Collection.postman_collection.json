	"item": [
		{
			"name": "Add Object",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var responseBody = pm.response.json();\r",
							"pm.environment.set(\"idObject\", responseBody.id);\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response is JSON\", function () {\r",
							"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r",
							"});\r",
							"\r",
							"pm.test(\"Device name is Device Demo Test Iphone 16 pro\", function () {\r",
							"    pm.expect(responseBody.name).to.eql(\"Device Demo Test Iphone 16 pro\");\r",
							"});\r",
							"\r",
							"pm.test(\"Price of Object is 59999.99\", function () {\r",
							"    pm.expect(responseBody.data.price).to.eql(59999.99);\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n   \"name\": \"Device Demo Test Iphone 16 pro\",\r\n   \"data\": {\r\n      \"year\": 2024,\r\n      \"price\": 59999.99,\r\n      \"CPU model\": \"Apple\",\r\n      \"Hard disk size\": \"1 TB\"\r\n   }\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{URL}}/objects",
					"host": [
						"{{URL}}"
					],
					"path": [
						"objects"
					]
				}
			},
			"response": []
		},
